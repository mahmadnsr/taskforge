import { createHash, randomBytes } from 'node:crypto';
import {
  BadRequestException,
  ConflictException,
  ForbiddenException,
  Injectable,
} from '@nestjs/common';
import { EmailService } from '../email/email.service.js';
import { ConfigService } from '@nestjs/config';
import { Prisma, Role } from '@prisma/client';
import { PrismaService } from '../prisma/prisma.service.js';
import { InviteMemberInput } from './dto/invite-member.input.js';

const NOT_A_MEMBER = 'You are not a member of this organization';
const INVALID_INVITE = 'Invalid or expired invitation';
const INVITE_TTL_MS = 7 * 24 * 60 * 60 * 1000; // 7 din

// Token high-entropy random hai, isliye fast SHA-256 kaafi hai (bcrypt nahi chahiye)
export function hashToken(token: string): string {
  return createHash('sha256').update(token).digest('hex');
}

@Injectable()
export class InvitationsService {
  constructor(
    private prisma: PrismaService,
    private config: ConfigService,
    private emailService: EmailService,
  ) {}

  async inviteMember(callerId: string, input: InviteMemberInput) {
    const { organizationId, role } = input;
    const email = input.email.trim().toLowerCase();

    const caller = await this.prisma.organizationMember.findUnique({
      where: { userId_organizationId: { userId: callerId, organizationId } },
      select: { role: true },
    });

    if (!caller) {
      throw new ForbiddenException(NOT_A_MEMBER);
    }
    if (caller.role === Role.EMPLOYEE) {
      throw new ForbiddenException('Insufficient role');
    }
    if (caller.role === Role.MANAGER && role !== Role.EMPLOYEE) {
      throw new ForbiddenException('Managers can only invite employees');
    }

    const existingMember = await this.prisma.organizationMember.findFirst({
      where: {
        organizationId,
        user: { email: { equals: email, mode: 'insensitive' } },
      },
      select: { id: true },
    });
    if (existingMember) {
      throw new ConflictException('This user is already a member');
    }

    const pending = await this.prisma.organizationInvitation.findFirst({
      where: {
        organizationId,
        email,
        acceptedAt: null,
        expiresAt: { gt: new Date() },
      },
      select: { id: true },
    });
    if (pending) {
      throw new ConflictException(
        'An active invitation already exists for this email',
      );
    }

    const token = randomBytes(32).toString('hex');

    const invitation = await this.prisma.organizationInvitation.create({
      data: {
        organizationId,
        email,
        role,
        tokenHash: hashToken(token),
        invitedById: callerId,
        expiresAt: new Date(Date.now() + INVITE_TTL_MS),
      },
      select: { id: true, email: true, role: true, expiresAt: true },
    });

    const isProduction = this.config.get<string>('NODE_ENV') === 'production';
    return { ...invitation, inviteToken: isProduction ? null : token };
  }

  async acceptInvitation(userId: string, token: string) {
    // Email hamesha DB se (token/input se nahi)
    const user = await this.prisma.user.findUnique({
      where: { id: userId },
      select: { email: true },
    });
    if (!user) {
      throw new BadRequestException(INVALID_INVITE);
    }

    const invitation = await this.prisma.organizationInvitation.findUnique({
      where: { tokenHash: hashToken(token) },
      select: {
        id: true,
        organizationId: true,
        email: true,
        role: true,
        expiresAt: true,
        acceptedAt: true,
      },
    });

    const now = new Date();

    // Sab failure cases ka same error: leak nahi
    if (
      !invitation ||
      invitation.acceptedAt ||
      invitation.expiresAt <= now ||
      invitation.email !== user.email.trim().toLowerCase()
    ) {
      throw new BadRequestException(INVALID_INVITE);
    }

    return this.prisma.$transaction(async (tx) => {
      // Atomic claim: do parallel requests me sirf ek ka count 1 hoga
      const claimed = await tx.organizationInvitation.updateMany({
        where: {
          id: invitation.id,
          acceptedAt: null,
          expiresAt: { gt: now },
        },
        data: { acceptedAt: now },
      });
      if (claimed.count === 0) {
        throw new BadRequestException(INVALID_INVITE);
      }

      try {
        await tx.organizationMember.create({
          data: {
            userId,
            organizationId: invitation.organizationId,
            role: invitation.role,
          },
        });
      } catch (e) {
        if (
          e instanceof Prisma.PrismaClientKnownRequestError &&
          e.code === 'P2002'
        ) {
          throw new ConflictException(
            'You are already a member of this organization',
          );
        }
        throw e;
      }

      return tx.organization.findUniqueOrThrow({
        where: { id: invitation.organizationId },
      });
    });
  }
}
