// ============================================================
// TaskForge — Prisma Schema
// Database: PostgreSQL
// ============================================================

generator client {
  provider = "prisma-client-js"
  output = "../node_modules/@prisma/client/.prisma/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_STATUS_CHANGED
  TASK_COMMENTED
  TASK_DEADLINE_REMINDER
}

enum TaskReminderType {
  DUE_24_HOURS
  DUE_1_HOUR
}

enum TaskReminderStatus {
  PENDING
  QUEUED
  PROCESSING
  SENT
  SKIPPED
}

// ============================================================
// USER
// ============================================================

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships     OrganizationMember[]
  refreshTokens   RefreshToken[]
  sentInvitations OrganizationInvitation[] @relation("InvitationsSent")
  createdProjects Project[]                @relation("ProjectsCreated")
  notifications   Notification[]           @relation("NotificationRecipient")
  taskReminders   TaskReminder[]
}

// ============================================================
// ORGANIZATION
// ============================================================

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members       OrganizationMember[]
  invitations   OrganizationInvitation[]
  projects      Project[]
  notifications Notification[]
  taskReminders TaskReminder[]
}

// ============================================================
// ORGANIZATION MEMBERSHIP
// ============================================================

model OrganizationMember {
  id             String   @id @default(uuid())
  userId         String
  organizationId String
  role           Role
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  projectMemberships ProjectMember[]
  tasksCreated       Task[]          @relation("TasksCreated")
  taskComments       TaskComment[]   @relation("TaskCommentsAuthored")

  @@unique([userId, organizationId])
  @@index([organizationId])
}

// ============================================================
// REFRESH TOKEN
// ============================================================

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}

// ============================================================
// ORGANIZATION INVITATION
// ============================================================

model OrganizationInvitation {
  id             String    @id @default(uuid())
  organizationId String
  email          String
  role           Role
  tokenHash      String    @unique
  invitedById    String
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitationsSent", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@index([expiresAt])
}

// ============================================================
// PROJECT
// ============================================================

model Project {
  id             String        @id @default(uuid())
  organizationId String
  name           String
  description    String?
  status         ProjectStatus @default(ACTIVE)
  createdById    String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("ProjectsCreated", fields: [createdById], references: [id], onDelete: Restrict)

  members ProjectMember[]
  tasks   Task[]

  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([createdById])
}

// ============================================================
// PROJECT MEMBERSHIP
// ============================================================

model ProjectMember {
  id             String   @id @default(uuid())
  projectId      String
  userId         String
  organizationId String
  createdAt      DateTime @default(now())

  project   Project            @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  orgMember OrganizationMember @relation(fields: [userId, organizationId], references: [userId, organizationId], onDelete: Cascade)

  tasksAssigned Task[] @relation("TasksAssigned")

  @@unique([projectId, userId])
  @@index([userId])
  @@index([organizationId])
}

// ============================================================
// TASK
// ============================================================

model Task {
  id             String       @id @default(uuid())
  organizationId String
  projectId      String
  title          String
  description    String?
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  createdById    String
  assigneeId     String?
  parentId       String?
  deletedAt      DateTime?
  dueDate        DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  comments      TaskComment[]
  checklistItems TaskChecklistItem[]
  activities    TaskActivity[]
  notifications Notification[]
  reminders     TaskReminder[]
  dependencies  TaskDependency[] @relation("DependentTask")
  dependents    TaskDependency[] @relation("BlockingTask")
  project       Project            @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  parent        Task?              @relation("TaskSubtasks", fields: [parentId, organizationId, projectId], references: [id, organizationId, projectId], onDelete: Restrict)
  subtasks      Task[]             @relation("TaskSubtasks")
  createdBy     OrganizationMember @relation("TasksCreated", fields: [createdById, organizationId], references: [userId, organizationId], onDelete: Restrict)
  assignee      ProjectMember?     @relation("TasksAssigned", fields: [projectId, assigneeId], references: [projectId, userId], onDelete: Restrict)

  @@unique([id, organizationId])
  @@unique([id, organizationId, projectId])
  @@index([projectId, status])
  @@index([projectId, priority])
  @@index([createdById])
  @@index([assigneeId])
  @@index([dueDate])
  @@index([organizationId])
  @@index([parentId])
}

model TaskDependency {
  organizationId String
  projectId String
  taskId String
  blockingTaskId String
  createdAt DateTime @default(now())

  task Task @relation("DependentTask", fields: [taskId, organizationId, projectId], references: [id, organizationId, projectId], onDelete: Restrict)
  blockingTask Task @relation("BlockingTask", fields: [blockingTaskId, organizationId, projectId], references: [id, organizationId, projectId], onDelete: Restrict)

  @@id([taskId, blockingTaskId])
  @@index([organizationId, projectId, blockingTaskId])
}

// ============================================================
// TASK CHECKLIST ITEM
// ============================================================

model TaskChecklistItem {
  id             String   @id @default(uuid())
  taskId         String
  organizationId String
  content        String
  completed      Boolean  @default(false)
  position       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  task Task @relation(fields: [taskId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([taskId, position])
  @@index([organizationId])
}

// ============================================================
// TASK ACTIVITY
// ============================================================

model TaskActivity {
  id             String   @id @default(uuid())
  taskId         String
  organizationId String
  actorId        String
  type           String
  details        Json?
  createdAt      DateTime @default(now())

  task Task @relation(fields: [taskId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([taskId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([organizationId])
}

// ============================================================
// TASK COMMENT
// ============================================================

model TaskComment {
  id             String   @id @default(uuid())
  organizationId String
  taskId         String
  authorId       String
  content        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  task   Task               @relation(fields: [taskId, organizationId], references: [id, organizationId], onDelete: Cascade)
  author OrganizationMember @relation("TaskCommentsAuthored", fields: [authorId, organizationId], references: [userId, organizationId], onDelete: Restrict)

  @@index([taskId, createdAt])
  @@index([authorId, organizationId])
}

// ============================================================
// NOTIFICATION
// ============================================================

model Notification {
  id             String           @id @default(uuid())
  organizationId String
  recipientId    String
  taskId         String
  taskReminderId String?          @unique
  type           NotificationType
  message        String
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  recipient    User          @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task         Task          @relation(fields: [taskId, organizationId], references: [id, organizationId], onDelete: Cascade)
  taskReminder TaskReminder? @relation(fields: [taskReminderId], references: [id], onDelete: SetNull)

  @@index([recipientId, createdAt, id])
  @@index([recipientId, readAt])
  @@index([organizationId])
}

// ============================================================
// TRANSACTIONAL OUTBOX
// ============================================================

model OutboxEvent {
  id            String    @id @default(uuid())
  eventType     String
  payload       Json
  createdAt     DateTime  @default(now())
  publishedAt   DateTime?
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lockedAt      DateTime?
  lockedBy      String?
  lastError     String?

  @@index([publishedAt, nextAttemptAt, createdAt])
  @@index([lockedAt])
}

// ============================================================
// TASK DEADLINE REMINDERS
// ============================================================

model TaskReminder {
  id                    String             @id @default(uuid())
  taskId                String
  organizationId        String
  recipientId           String
  type                  TaskReminderType
  status                TaskReminderStatus @default(PENDING)
  dueDate               DateTime
  notificationAt        DateTime?
  emailQueuedAt         DateTime?
  emailProcessingAt     DateTime?
  emailEnqueueClaimedAt DateTime?
  emailSentAt           DateTime?
  lastError             String?
  sentAt                DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  task         Task          @relation(fields: [taskId, organizationId], references: [id, organizationId], onDelete: Cascade)
  recipient    User          @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  notification Notification?

  @@unique([taskId, dueDate, recipientId, type])
  @@index([status, dueDate])
  @@index([recipientId, status])
  @@index([organizationId])
}
